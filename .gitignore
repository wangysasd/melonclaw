# 本地环境配置：保留可提交的示例文件，不提交真实凭据。
.env
.env.*
!.env.example

# Python 运行环境与解释器产物。
.venv/
venv/
__pycache__/
*.py[cod]

# 测试、静态检查和覆盖率缓存。
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
temp/

# 构建与打包产物。
build/
dist/
*.egg-info/

# 本地部署配置与开发设计记录，不纳入远程版本控制。
/deploy/
/note/
/todo.md

# 本地导入的 CICC Skills，不纳入项目版本控制。
/skills/cicc-*/
/skills/htsc-*/
/skills-lock.json

# 本地编辑器与系统文件。
.agents/
.codebuddy/
.workbuddy/
.idea/
.vscode/
.DS_Store
.playwright-cli/
# 本地资源数据根（Skill/MCP 内容），可用 MELONCLAW_DATA_DIR 重定向。
# 版本化内置共享 Skill；其他本地内容（含 CICC/HTSC 内部研报类）不提交。
# users/、tmp/ 只保留目录占位（.gitkeep），其内容不提交。
.data/*
!.data/skills/
.data/skills/*
!.data/skills/shared/
.data/skills/shared/*
!.data/skills/shared/tushare-fetcher/
!.data/skills/shared/melonclaw-tutorial/
!.data/skills/users/
!.data/skills/tmp/
.data/skills/users/*
.data/skills/tmp/*
!.data/skills/users/.gitkeep
!.data/skills/tmp/.gitkeep
