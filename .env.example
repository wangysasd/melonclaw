# MelonClaw 配置示例
# 复制为项目根目录的 .env 后，只修改你需要的项目。
# 已在启动终端导出的同名环境变量优先于 .env。不要提交实际凭据。
# 模型名称、模型服务地址和模型 Key 在页面及数据库中配置，不写在这里。

# 1. 数据库（首次启动必填）
DATABASE_URL=

# 2. 可选搜索
TAVILY_API_KEY=

# 3. 助手名称与数据目录 聊天中显示的助手名称；修改后重启前端。
MELONCLAW_NAME=MelonClaw

# 会话和项目的持久工作区（含附件、输出文件）；留空使用 ~/.melonclaw/workspaces。
MELONCLAW_WORKSPACE_DIR=
# Skill 等平台资源目录，与工作区分开；留空使用仓库下的 .data/。
MELONCLAW_DATA_DIR=
# 用户问题卡有效期，单位为秒；默认 86400（24 小时）。
MELONCLAW_USER_INPUT_TTL_SECONDS=86400

# 4. 附件常用限制
# 大小单位为 MiB（1024 × 1024 字节）。
# 单个附件最大大小；默认 20 MiB。
MELONCLAW_ATTACHMENT_MAX_FILE_MB=20
# 每条消息最多的附件数量；默认 10。
MELONCLAW_ATTACHMENT_MAX_PER_MESSAGE=10
# 每条消息所有附件的总大小；默认 50 MiB。
MELONCLAW_ATTACHMENT_MAX_TOTAL_MB=50
# 单个项目/会话工作区的附件总容量；默认 1024 MiB。
MELONCLAW_ATTACHMENT_PROJECT_MAX_MB=1024
# 发给模型的图片最长边，单位为像素；默认 1568。
MELONCLAW_ATTACHMENT_IMAGE_MAX_EDGE=1568
# 出站 JPEG 压缩质量；默认 85，实际范围为 1–95。
MELONCLAW_ATTACHMENT_IMAGE_JPEG_QUALITY=85
# 图片转换缓存数量；默认 32。
MELONCLAW_ATTACHMENT_IMAGE_CACHE_ENTRIES=32
# 其他附件解析安全限制通常保持代码默认值，详见 src/melonclaw/core/config.py。

# 5. 按需工具选择
# 修改后重启后端。基础工具不占工具池容量。
# 每个会话业务工具池容量；默认 16。
MELONCLAW_TOOL_POOL_SIZE=16
# 每次工具选择的数量上限，实际不超过工具池容量；默认 8。
MELONCLAW_TOOL_SELECTION_SIZE=8
# 每条用户消息最多处理的工具发现请求数，并行批次共享此预算；默认 4。
MELONCLAW_TOOL_SELECTION_MAX_REQUESTS=4
# 单次工具选择超时，单位为秒；默认 10。
MELONCLAW_TOOL_SELECTION_TIMEOUT_SECONDS=10

# 6. Agent 运行控制
# 修改后重启后端。摘要触发阈值和输出预留须能放入模型上下文窗口。
# 为模型输出预留的 token 数；默认 4096。
MELONCLAW_AGENT_OUTPUT_RESERVE=4096
# 达到模型上下文窗口的此比例时触发摘要；范围为 0–1，默认 0.8。
MELONCLAW_AGENT_SUMMARY_TRIGGER_RATIO=0.8
# 摘要后保留的近期上下文 token 预算；默认 4096。
MELONCLAW_AGENT_SUMMARY_KEEP_TOKENS=4096
# 每条用户消息、每个 Agent 的模型调用上限；默认 30，审批恢复不清零。
MELONCLAW_AGENT_MODEL_CALL_LIMIT=30
# 每条用户消息、每个 Agent 的工具调用上限；默认 100，审批恢复不清零。
MELONCLAW_AGENT_TOOL_CALL_LIMIT=100
# 初次请求之外的额外重试次数；默认 2，设为 0 可禁用重试。
MELONCLAW_AGENT_RETRY_MAX_RETRIES=2
# 首次重试等待时间，单位为秒；默认 1。
MELONCLAW_AGENT_RETRY_INITIAL_DELAY=1
# 最大重试等待时间，单位为秒且不得小于初始等待时间；默认 10。
MELONCLAW_AGENT_RETRY_MAX_DELAY=10
# 启用模型用量观测；接受 true/false 或 1/0，默认 true。
MELONCLAW_AGENT_USAGE_ENABLED=true
# 向 Agent 提供任务清单工具；接受 true/false 或 1/0，默认 true。
MELONCLAW_AGENT_TODO_ENABLED=true
# Agent 实例缓存容量；默认 32。
MELONCLAW_AGENT_CACHE_ENTRIES=32

# 7. 身份代理（仅可信网关部署需要，普通本地开发保持未设置）
# 填入可信网关注入的请求头名称，例如 X-User-Id；留空/不设置走开发身份流程。
# 只有网关覆盖客户端同名请求头并阻断绕过网关的访问时才能启用。
# MELONCLAW_IDENTITY_HEADER=X-User-Id
