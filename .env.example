
TAVILY_API_KEY=
DATABASE_URL=

# Assistant display name in chat (restart frontend after changing)
MELONCLAW_NAME=MelonClaw

# Attachment limits (optional; defaults are documented in README.md)
MELONCLAW_ATTACHMENT_MAX_FILE_MB=20
MELONCLAW_ATTACHMENT_MAX_PER_MESSAGE=10
MELONCLAW_ATTACHMENT_MAX_TOTAL_MB=50
MELONCLAW_ATTACHMENT_PROJECT_MAX_MB=1024
MELONCLAW_ATTACHMENT_IMAGE_MAX_EDGE=1568
MELONCLAW_ATTACHMENT_IMAGE_JPEG_QUALITY=85
MELONCLAW_ATTACHMENT_IMAGE_CACHE_ENTRIES=32

# Optional: when set, user_id is read from this trusted-gateway request header
# instead of the page-submitted query/form value. Leave empty for the dev flow.
# MELONCLAW_IDENTITY_HEADER=X-User-Id

# 按需官方工具选择（修改后重启；代码自带以下默认值）
MELONCLAW_TOOL_POOL_SIZE=16
# 单次选择上限，不超过池容量
MELONCLAW_TOOL_SELECTION_SIZE=8
# 每条用户消息最多接受的发现请求数，并行批次共享预算
MELONCLAW_TOOL_SELECTION_MAX_REQUESTS=4
MELONCLAW_TOOL_SELECTION_TIMEOUT_SECONDS=10

# Agent 运行控制：均有代码默认值；模型/凭据仍只从数据库解析。
MELONCLAW_AGENT_OUTPUT_RESERVE=4096
# 压缩阈值 = 数据库中当前模型的 context_window × 此比例；模型窗口默认 1,000,000 tokens。
MELONCLAW_AGENT_SUMMARY_TRIGGER_RATIO=0.8
MELONCLAW_AGENT_SUMMARY_KEEP_TOKENS=4096
# 每条用户消息、每个 Agent 的预算；审批恢复不清零。
MELONCLAW_AGENT_MODEL_CALL_LIMIT=30
MELONCLAW_AGENT_TOOL_CALL_LIMIT=100
# 初次请求之外最多重试两次，SDK 重试关闭；已经输出片段不重试。
MELONCLAW_AGENT_RETRY_MAX_RETRIES=2
MELONCLAW_AGENT_RETRY_INITIAL_DELAY=1
MELONCLAW_AGENT_RETRY_MAX_DELAY=10
MELONCLAW_AGENT_USAGE_ENABLED=true
MELONCLAW_AGENT_TODO_ENABLED=true
