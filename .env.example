# MelonClaw 配置示例（复制为 .env 或 .env.prod 后按需修改；终端已导出的同名环境变量优先于此文件）
# 模型名称、服务地址和模型 Key 在页面及数据库中配置；Linux 部署模板见 ops/melonclaw.env.example。

# 1. 核心必填与运行身份
DATABASE_URL=""                               # [必填] PostgreSQL 连接串（如 postgresql+asyncpg://user:pass@127.0.0.1:5432/melonclaw）
profile=dev                                   # [必填] 运行模式：dev（开启开发免密切换）| prod（生产环境）
MELONCLAW_NAME=Melon                          # 聊天界面显示的助手名称（修改后重启前端）
DEEPSEEK_API_KEY=""                           # 可选：DeepSeek 联网搜索与网页读取工具 Key  # 可选；使用联网搜索或网页读取功能时必填，修改后需重启服务。

# 2. MELONCLAW_* 目录、网络与安全边界
MELONCLAW_WORKSPACE_DIR=""                    # 会话和项目的持久工作区；留空默认 ~/.melonclaw/workspaces
MELONCLAW_DATA_DIR=""                         # Skill 等平台资源目录；留空默认 ~/.melonclaw/data
MELONCLAW_HOST=127.0.0.1                      # 后端监听地址
MELONCLAW_PORT=8000                           # 后端监听端口
MELONCLAW_ALLOWED_ORIGINS=""                  # 允许的跨域/Cookie 来源（本地留空默认 8001；生产填站点 Origin 如 https://melonclaw.cn，不带路径）
MELONCLAW_SHELL_ENV_ALLOWLIST=""              # 额外放行给 Agent Shell 的环境变量名（常用 Skill 变量已由 core/defaults.py 默认放行）
# MELONCLAW_IDENTITY_HEADER=X-User-Id         # 仅可信网关部署启用（普通本地开发保持注释）

# 3. MCP/Skill 系统级外部凭据
# 按已启用的 MCP/Skill 按需填写；以下为空值示例，不包含真实凭据。
TUSHARE_MCP_TOKEN=
HTSC_APP_KEY=

# 4. MELONCLAW_* 运行常量（修改后重启后端）
MELONCLAW_USER_INPUT_TTL_SECONDS=86400        # 用户问题卡有效期（秒，默认 24 小时）
MELONCLAW_AGENT_OUTPUT_RESERVE=4096           # 模型输出预留 token
MELONCLAW_AGENT_SUMMARY_TRIGGER_RATIO=0.8     # 触发上下文摘要的窗口比例（0~1）
MELONCLAW_AGENT_SUMMARY_KEEP_TOKENS=4096      # 摘要后保留的近期上下文 token
MELONCLAW_AGENT_MODEL_CALL_LIMIT=1000         # 单条用户消息、每个 Agent 的模型调用上限
MELONCLAW_AGENT_TOOL_CALL_LIMIT=5000          # 单条用户消息、每个 Agent 的工具调用上限
MELONCLAW_AGENT_RETRY_MAX_RETRIES=2           # 初次请求外的额外重试次数（0 禁用）
MELONCLAW_AGENT_RETRY_INITIAL_DELAY=1         # 首次重试等待时间（秒）
MELONCLAW_AGENT_RETRY_MAX_DELAY=10            # 最大重试等待时间（秒）
MELONCLAW_AGENT_USAGE_ENABLED=true            # 启用模型用量观测（true/false）
MELONCLAW_AGENT_TODO_ENABLED=true             # 向 Agent 提供任务清单工具（true/false）
MELONCLAW_AGENT_CACHE_ENTRIES=32              # Agent 实例缓存容量
MELONCLAW_TOOL_POOL_SIZE=16                   # 单会话业务工具池容量（基础工具不占容量）
MELONCLAW_TOOL_SELECTION_SIZE=8               # 单次工具选择数量上限
MELONCLAW_TOOL_SELECTION_MAX_REQUESTS=4       # 单条消息最多处理的工具发现请求数
MELONCLAW_TOOL_SELECTION_TIMEOUT_SECONDS=10   # 单次工具选择超时（秒）
MELONCLAW_ATTACHMENT_MAX_FILE_MB=20           # 单个附件最大大小（MiB）
MELONCLAW_ATTACHMENT_MAX_PER_MESSAGE=10       # 单条消息最多附件数量
MELONCLAW_ATTACHMENT_MAX_TOTAL_MB=50          # 单条消息所有附件总大小上限（MiB）
MELONCLAW_ATTACHMENT_PROJECT_MAX_MB=1024      # 单个项目/会话工作区附件总容量上限（MiB）
MELONCLAW_ATTACHMENT_IMAGE_MAX_EDGE=1568      # 发给模型的图片最长边（像素）
MELONCLAW_ATTACHMENT_IMAGE_JPEG_QUALITY=85    # 出站 JPEG 压缩质量（1~95）
MELONCLAW_ATTACHMENT_IMAGE_CACHE_ENTRIES=32   # 图片转换缓存数量
MELONCLAW_TASK_EXECUTION_TIMEOUT_SECONDS=1800 # 单次定时任务执行超时（秒）
MELONCLAW_TASK_RESULT_MAX_CHARS=200000        # 定时任务结果最大字符数
MELONCLAW_TASK_GLOBAL_CONCURRENCY=2           # 全局定时任务并发上限
MELONCLAW_TASK_USER_CONCURRENCY=1             # 单用户定时任务并发上限
MELONCLAW_TASK_QUEUE_TIMEOUT_SECONDS=86400    # 定时任务排队超时（秒）
MELONCLAW_TASK_CHECKPOINT_RETENTION_DAYS=30   # 任务 Checkpoint 保留天数
MELONCLAW_TASK_OPERATION_RETENTION_DAYS=30    # 任务操作幂等回执保留天数
MELONCLAW_TASK_HISTORY_TIMEOUT_SECONDS=60     # 任务历史准备超时（秒）
MELONCLAW_TASK_HISTORY_SUMMARY_MAX_CALLS=4    # 任务历史单次最多摘要次数
MELONCLAW_TASK_CLEANUP_INTERVAL_SECONDS=3600  # 过期任务数据清理周期（秒）
MELONCLAW_TASK_POLL_SECONDS=2                 # 内置任务调度器轮询间隔（秒）

# 5. Langfuse 监控
LANGFUSE_TRACING_ENABLED=false                # 可选：是否启用 Langfuse 追踪（true/false）
LANGFUSE_PUBLIC_KEY=""                        # 可选：Langfuse Public Key
LANGFUSE_SECRET_KEY=""                        # 可选：Langfuse Secret Key
LANGFUSE_BASE_URL=""                          # 可选：Langfuse 服务地址（如 https://jp.cloud.langfuse.com）
LANGFUSE_TRACING_ENVIRONMENT=development      # 可选：Langfuse 环境标识（开发 development / 生产 production）
MELONCLAW_LANGFUSE_CAPTURE_CONTENT=false      # 可选：是否上传脱敏正文到 Langfuse（true/false）
