[Unit]
Description=MelonClaw API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=melonclaw
Group=melonclaw
WorkingDirectory=/opt/melonclaw
Environment=MELONCLAW_ENV_FILE=/etc/melonclaw/melonclaw.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/melonclaw/.venv/bin/melonclaw-web
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
StateDirectory=melonclaw
StateDirectoryMode=0700
LogsDirectory=melonclaw
LogsDirectoryMode=0700
RuntimeDirectory=melonclaw
RuntimeDirectoryMode=0700
StandardOutput=append:/var/log/melonclaw/backend.log
StandardError=append:/var/log/melonclaw/backend.log

[Install]
WantedBy=multi-user.target
