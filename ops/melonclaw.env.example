# 安装到 /etc/melonclaw/melonclaw.env，权限 0600，属主为 ubuntu:ubuntu。
profile=prod
DATABASE_URL=
# 登录 JWT 签名密钥，至少 32 个字符。缺失或过短时 Web 拒绝启动。
MELONCLAW_JWT_SECRET=
# 留空时新令牌有效期为 1000 小时。
MELONCLAW_TOKEN_TTL_HOURS=
# 隐私说明上的运营主体。申请邮箱复用文末的 MELONCLAW_REPORT_CONTACT_EMAIL。正式开放注册前填写真实主体并完成收件测试。
MELONCLAW_OPERATOR_NAME=
# 短信验证默认关闭。启用前先完成 database/updates 的 20261126_sms_auth，并填写下面的值。
MELONCLAW_SMS_ENABLED=false
MELONCLAW_REGISTRATION_ENABLED=false
MELONCLAW_SMS_ACCESS_KEY_ID=
MELONCLAW_SMS_ACCESS_KEY_SECRET=
MELONCLAW_SMS_SIGN_NAME=
MELONCLAW_SMS_TEMPLATE_AUTH=
MELONCLAW_SMS_TEMPLATE_BIND=
MELONCLAW_SMS_TEMPLATE_RESET=
MELONCLAW_PHONE_HMAC_KEY=
MELONCLAW_DATA_DIR=/var/lib/melonclaw/data
# 审计写入失败的接收地址。留空则只记应用警告。不要把真实地址写入仓库。
MELONCLAW_AUDIT_ALERT_WEBHOOK_URL=
MELONCLAW_AUDIT_ALERT_TIMEOUT_SECONDS=2
MELONCLAW_AUDIT_ALERT_RETRY_SECONDS=300
MELONCLAW_WORKSPACE_DIR=/var/lib/melonclaw/workspaces
MELONCLAW_HOST=127.0.0.1
MELONCLAW_PORT=8000
# 改为实际访问站点的 Origin（协议 + 域名 + 可选端口），不要带路径。
MELONCLAW_ALLOWED_ORIGINS=https://melonclaw.cn
# 联网搜索、网页读取、语音识别和知识库 OCR。留空仍可启动。
DEEPSEEK_API_KEY=

# 任务调度随 Web 启动并使用同一数据库；服务启动不建表、不升级。
MELONCLAW_TASK_GLOBAL_CONCURRENCY=2
MELONCLAW_TASK_USER_CONCURRENCY=1
MELONCLAW_TASK_QUEUE_TIMEOUT_SECONDS=86400
MELONCLAW_TASK_EXECUTION_TIMEOUT_SECONDS=1800
MELONCLAW_TASK_RESULT_MAX_CHARS=200000
MELONCLAW_TASK_CHECKPOINT_RETENTION_DAYS=30
MELONCLAW_TASK_OPERATION_RETENTION_DAYS=30
MELONCLAW_TASK_HISTORY_TIMEOUT_SECONDS=60
MELONCLAW_TASK_HISTORY_SUMMARY_MAX_CALLS=4
MELONCLAW_TASK_CLEANUP_INTERVAL_SECONDS=3600
MELONCLAW_TASK_POLL_SECONDS=2

# 知识库 OCR 使用 DeepSeek 官方接口，凭据复用 DEEPSEEK_API_KEY。
KNOWLEDGE_OCR_TIMEOUT_SECONDS=180

# 投诉页联系渠道。留空则只使用站内表单，不展示邮箱或响应时限。
MELONCLAW_REPORT_CONTACT_EMAIL=
MELONCLAW_REPORT_CONTACT_NAME=
MELONCLAW_REPORT_RESPONSE_HOURS=
