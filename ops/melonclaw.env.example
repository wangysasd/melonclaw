# 安装到 /etc/melonclaw/melonclaw.env，权限 0600，属主为运行服务的账号。
profile=prod
DATABASE_URL=
MELONCLAW_DATA_DIR=/var/lib/melonclaw/data
MELONCLAW_WORKSPACE_DIR=/var/lib/melonclaw/workspaces
MELONCLAW_HOST=127.0.0.1
MELONCLAW_PORT=8000
# 改为实际访问站点的 Origin（协议 + 域名 + 可选端口），不要带路径。
MELONCLAW_ALLOWED_ORIGINS=https://melonclaw.example.com
TAVILY_API_KEY=
