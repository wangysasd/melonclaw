# 安装到 /etc/melonclaw/melonclaw.env，权限 0600，属主为 ubuntu:ubuntu。
profile=prod
DATABASE_URL=
MELONCLAW_DATA_DIR=/var/lib/melonclaw/data
MELONCLAW_WORKSPACE_DIR=/var/lib/melonclaw/workspaces
MELONCLAW_HOST=127.0.0.1
MELONCLAW_PORT=8000
# 改为实际访问站点的 Origin（协议 + 域名 + 可选端口），不要带路径。
MELONCLAW_ALLOWED_ORIGINS=https://melonclaw.example.com
TAVILY_API_KEY=

# 任务调度随 Web 启动并使用同一数据库；服务启动不建表、不升级。
MELONCLAW_TASK_GLOBAL_CONCURRENCY=2
MELONCLAW_TASK_USER_CONCURRENCY=1
MELONCLAW_TASK_QUEUE_TIMEOUT_SECONDS=86400
MELONCLAW_TASK_EXECUTION_TIMEOUT_SECONDS=1800
MELONCLAW_TASK_RESULT_MAX_CHARS=200000
MELONCLAW_TASK_CHECKPOINT_RETENTION_DAYS=30
MELONCLAW_TASK_OPERATION_RETENTION_DAYS=30
MELONCLAW_TASK_HISTORY_TIMEOUT_SECONDS=60
MELONCLAW_TASK_HISTORY_SUMMARY_MAX_CALLS=4
MELONCLAW_TASK_CLEANUP_INTERVAL_SECONDS=3600
MELONCLAW_TASK_POLL_SECONDS=2
